<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chai Corner - Home</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <header>
        <h1>Welcome to Chai Corner</h1>
        <p>Fresh Chai, Fresh Moments!</p>
    </header>

    <nav>
        <a href="index.html">Home</a>
        <a href="menu.html">Menu</a>
        <a href="gallery.html">Gallery</a>
    </nav>

    <main>

        <section class="welcome">
            <h2>CHAI CORNER</h2>
            <p>Enjoy delicious tea and traditional snacks!</p>
        </section>

        <section class="menu">

            <img src="tea.png" alt="Cup of Tea"
                 class="tea-image">

            <h2>Our Special Items</h2>

            <table>
                <tr>
                    <th>Item</th>
                    <th>Price</th>
                    <th>Category</th>
                </tr>

                <tr>
                    <td>Tea</td>
                    <td>Rs. 100</td>
                    <td>Drinks</td>
                </tr>

                <tr>
                    <td>Samosa</td>
                    <td>Rs. 50</td>
                    <td>Food</td>
                </tr>

                <tr>
                    <td>Pakoray</td>
                    <td>Rs. 120</td>
                    <td>Food</td>
                </tr>
            </table>

        </section>

        <button onclick="placeOrder()">Order</button>

        <p id="message"></p>

    </main>

    <footer>
        <p>Enjoy!</p>
    </footer>

    <script>
        function placeOrder() {
            alert("Thank you for choosing Chai Corner!");
            document.getElementById("message").innerHTML =
                "Visit our menu to explore our items!";
        }
    </script>

</body>
</html>
 <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chai Corner - Menu</title>
    <link rel="stylesheet" href="style.css">

    <style>
        .menu-items {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin: 30px auto;
        }

        .menu-card {
            background-color: #f5e7d0;
            padding: 15px;
            border-radius: 12px;
            text-align: center;
        }

        .menu-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 8px;
        }

        .menu-card h3 {
            color: #704020;
        }

        .price {
            font-size: 18px;
            font-weight: bold;
            color: #245331;
        }

        @media (max-width: 700px) {
            .menu-items {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>Chai Corner</h1>
        <p>Fresh Chai, Fresh Moments!</p>
    </header>

    <nav>
        <a href="index.html">Home</a>
        <a href="menu.html">Menu</a>
        <a href="gallery.html">Gallery</a>
    </nav>

    <main>

        <h2>OUR MENU</h2>

        <p>Enjoy our freshly prepared tea and snacks!</p>

        <div class="menu-items">

            <!-- Tea -->
            <div class="menu-card">
                <img src="tea.png" alt="Tea">

                <h3>Fresh Tea</h3>

                <p>Hot and refreshing traditional tea.</p>

                <p class="price">Rs. 100</p>
            </div>

            <!-- Samosa -->
            <div class="menu-card">
                <img src="samosa.png" alt="Samosa">

                <h3>Crispy Samosa</h3>

                <p>Delicious golden and crispy samosa.</p>

                <p class="price">Rs. 50</p>
            </div>

            <!-- Pakoray -->
            <div class="menu-card">
                <img src="pakoray.png" alt="Pakoray">

                <h3>Tasty Pakoray</h3>

                <p>Fresh and crispy traditional pakoray.</p>

                <p class="price">Rs. 120</p>
            </div>

        </div>

        <button onclick="placeOrder()">Order Now</button>

    </main>

    <footer>
        <p>Enjoy!</p>
    </footer>

    <script>
        function placeOrder() {
            alert("Thank you for choosing Chai Corner!");
        }
    </script>

</body>
</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Chai Corner - Gallery</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #fffaf5;
            color: #333;
        }

        header {
            background-color: #8b5a4a;
            color: white;
            text-align: center;
            padding: 25px;
        }

        header h1 {
            margin: 0;
        }

        header p {
            margin-bottom: 0;
        }

        nav {
            background-color: #a67360;
            text-align: center;
            padding: 15px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 15px;
            font-weight: bold;
        }

        nav a:hover {
            text-decoration: underline;
        }

        main {
            text-align: center;
            padding: 30px 15px;
        }

        h2 {
            color: #8b5a4a;
            font-size: 28px;
        }

        .gallery {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            width: 90%;
            max-width: 1100px;
            margin: 30px auto;
        }

        .gallery-item {
            background-color: #f8eee8;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 3px 8px #00000020;
        }

        .gallery-item img {
            width: 100%;
            height: 250px;
            object-fit: cover;
            border-radius: 8px;
        }

        .gallery-item h3 {
            color: #8b5a4a;
        }

        .gallery-item p {
            font-size: 14px;
        }

        .gallery-item:hover {
            background-color: #ead6c8;
        }

        button {
            background-color: #8b5a4a;
            color: white;
            padding: 12px 30px;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            font-size: 16px;
            margin: 20px;
        }

        button:hover {
            background-color: #654033;
        }

        footer {
            background-color: #e3edcf;
            text-align: center;
            padding: 15px;
        }

        @media (max-width: 700px) {
            .gallery {
                grid-template-columns: 1fr;
            }

            nav a {
                margin: 8px;
            }
        }
    </style>

</head>

<body>

    <header>
        <h1>Chai Corner</h1>
        <p>Fresh Chai, Fresh Moments!</p>
    </header>

    <nav>
        <a href="index.html">Home</a>
        <a href="menu.html">Menu</a>
        <a href="gallery.html">Gallery</a>
    </nav>

    <main>

        <h2>Our Gallery</h2>
        <p>Explore our delicious chai and traditional snacks!</p>

        <div class="gallery">

            <!-- Tea Image -->
            <div class="gallery-item">
                <img src="tea.png" alt="Cup of Chai">
                <h3>Fresh Chai</h3>
                <p>A warm and refreshing cup of traditional chai.</p>
            </div>

            <!-- Samosa Image -->
            <div class="gallery-item">
                <img src="samosa.png" alt="Samosa">
                <h3>Crispy Samosa</h3>
                <p>Golden and crispy samosas served fresh.</p>
            </div>

            <!-- Pakoray Image -->
            <div class="gallery-item">
                <img src="pakoray.png" alt="Pakoray">
                <h3>Tasty Pakoray</h3>
                <p>Delicious pakoray with a crispy texture.</p>
            </div>

        </div>

        <button onclick="viewMenu()">View Menu</button>

    </main>

    <footer>
        <p>Enjoy!</p>
    </footer>

    <script>
        function viewMenu() {
            window.location.href = "menu.html";
        }
    </script>

</body>
</html>

